  "info": {
    "_postman_id": "a83761d8-b5e8-45b9-91cc-91ac43e3ebdb",
    "name": "RateHawk / ETG API (WorldOta APIv3) Booking Hotel Search API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "B2B hotel and travel booking API operated by Emerging Travel Group (ETG) and exposed to partners as the RateHawk API. The Partner API (pAPI) v3 covers hotel search (SERP by region, hotels, and geo), hotelpage rate actualization, prebook, the asynchronous order booking flow (form, finish, finish status), order information, cancellation, and static hotel content. All endpoints are HTTP POST that accept and return JSON and authenticate with HTTP Basic using a key id (username) and key (password).\n\nContact Support:\n Name: ETG API Support",
      "type": "text/plain"
    }
  }
